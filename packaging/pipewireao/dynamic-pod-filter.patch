+  if (spa_pod_filter (&builder.b, &result, self->pod,
+          filter ? filter->pod : NULL) >= 0)
+    copy = wp_spa_pod_new_wrap_copy (result);
+  spa_pod_dynamic_builder_clean (&builder);
+  return copy;
 }
 
